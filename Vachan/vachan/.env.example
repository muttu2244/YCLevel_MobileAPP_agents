# Copy to .env — every value below has a working default, so an empty file is
# fine too. Never commit the filled-in .env.

# ---------------------------------------------------------------- database ---
# Local, zero-install (default). The file is created on `make init-db`.
DATABASE_URL=sqlite:///./vachan.db
# Hosted Postgres when you want a real server (Supabase, Neon, Fly).
# Supabase: Project settings → Database → Connection string. Either works —
# store.py turns off prepared statements automatically for the pooler, because
# pgbouncer in transaction mode cannot keep them between transactions.
#   direct    postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
#   pooler    postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Run db/schema.sql then db/supabase_rls.sql once, before the first command.
# The browser app connects separately with its URL + anon key — see docs/SUPABASE.md.

# ------------------------------------------------------------------- model ---
# mock      = built-in rule extractor. No key, no network, works offline.
# ollama    = a local model on your machine (fully free, no rate limits).
# openai    = any OpenAI-compatible endpoint: GitHub Models, Groq, Gemini,
#             Together, or Azure AI Foundry once you have access.
VACHAN_LLM_MODE=mock
VACHAN_MODEL=llama3.1
VACHAN_BASE_URL=http://localhost:11434
VACHAN_API_KEY=

# Examples for the free tiers (uncomment one pair and set the mode to `openai`):
# GitHub Models  VACHAN_BASE_URL=https://models.inference.ai.azure.com   VACHAN_MODEL=gpt-4o-mini
# Groq           VACHAN_BASE_URL=https://api.groq.com/openai/v1          VACHAN_MODEL=llama-3.3-70b-versatile
# Gemini         VACHAN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  VACHAN_MODEL=gemini-2.0-flash
# Foundry/Azure  VACHAN_BASE_URL=https://<resource>.services.ai.azure.com/models  VACHAN_MODEL=<deployment>

# -------------------------------------------------------------- business -----
VACHAN_BUSINESS=Sharma Interiors
VACHAN_OWNER=Rakesh (me)
VACHAN_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------ intake ---
# Telegram is the prototype intake channel (the plan's WhatsApp workaround).
# Create a bot with @BotFather and paste the token here — never in code.
TELEGRAM_BOT_TOKEN=

# --------------------------------------------------------------- tracing -----
# Langfuse free tier traces every agent run. Optional; leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
